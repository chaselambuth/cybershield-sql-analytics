table FactLatency
	lineageTag: 1e9ef66d-ea82-5f14-9519-c03db990fd8c

	measure 'Median call ms' = IF(HASONEVALUE('DimDetector'[detector_id]), SELECTEDVALUE('FactLatency'[median_ms]), BLANK())
		formatString: 0.000
		lineageTag: 67d42a8f-5126-55ba-b809-f03e1a5bc989

	measure 'P95 call ms' = IF(HASONEVALUE('DimDetector'[detector_id]), SELECTEDVALUE('FactLatency'[p95_ms]), BLANK())
		formatString: 0.000
		lineageTag: b8a62a82-e160-5c59-9700-b6180d6a0e0a

	measure 'Measured calls' = IF(HASONEVALUE('DimDetector'[detector_id]), SELECTEDVALUE('FactLatency'[calls]), BLANK())
		formatString: 0
		lineageTag: dbb3105f-93c4-591c-964f-8b865d0eb232

	measure 'Rows per second' = IF(HASONEVALUE('DimDetector'[detector_id]), SELECTEDVALUE('FactLatency'[rows_per_second]), BLANK())
		formatString: #,0
		lineageTag: 6fbdb100-3a13-5d28-a4d5-4b50d751884e

	measure 'Amortized us per row' = IF(HASONEVALUE('DimDetector'[detector_id]), SELECTEDVALUE('FactLatency'[amortized_us_per_row]), BLANK())
		formatString: 0.00
		lineageTag: 5f2e9878-9cac-5463-9572-c46e232413c1


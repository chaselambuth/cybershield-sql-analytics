table FactEvaluation
	lineageTag: 4f2131f8-eaae-5cf8-be6a-b7058c05429f

	measure 'Caught positives' = IF(HASONEVALUE('DimDetector'[detector_id]), SUM('FactEvaluation'[tp]), BLANK())
		formatString: 0
		lineageTag: 34fdfaa6-5dd2-558f-8f35-a85e16606467

	measure 'False positive windows' = IF(HASONEVALUE('DimDetector'[detector_id]), SUM('FactEvaluation'[fp]), BLANK())
		formatString: #,0
		lineageTag: 670217de-79b3-5685-91ed-690b36c66ef4

	measure 'Recall rate' = IF(HASONEVALUE('DimDetector'[detector_id]), DIVIDE(SUM('FactEvaluation'[tp]), SUM('FactEvaluation'[tp]) + SUM('FactEvaluation'[fn])), BLANK())
		formatString: 0.0%
		lineageTag: d0488bba-1bdc-5ecf-acb2-7d55a3809607

	measure 'Precision rate' = IF(HASONEVALUE('DimDetector'[detector_id]), DIVIDE(SUM('FactEvaluation'[tp]), SUM('FactEvaluation'[tp]) + SUM('FactEvaluation'[fp])), BLANK())
		formatString: 0.0%
		lineageTag: 60e65b95-fc1a-5660-b9bb-35fa73f540bd

	measure 'F1 score' = IF(HASONEVALUE('DimDetector'[detector_id]), DIVIDE(2 * SUM('FactEvaluation'[tp]), 2 * SUM('FactEvaluation'[tp]) + SUM('FactEvaluation'[fp]) + SUM('FactEvaluation'[fn])), BLANK())
		formatString: 0.000
		lineageTag: a3967941-b77c-5e85-9929-d1ca4ce21d49

	measure 'False alerts per 1000' = IF(HASONEVALUE('DimDetector'[detector_id]), DIVIDE(1000 * SUM('FactEvaluation'[fp]), SUM('FactEvaluation'[fp]) + SUM('FactEvaluation'[tn])), BLANK())
		formatString: 0.00
		lineageTag: 1d28093a-ce45-5bc0-b49d-5458c4513473

	measure 'Caught of total' = IF(HASONEVALUE('DimDetector'[detector_id]), FORMAT(SUM('FactEvaluation'[tp]), "0") & " of " & FORMAT(SUM('FactEvaluation'[positives]), "0"), "Select one detector")
		lineageTag: a29837d8-5c58-5f7c-a4c2-0795c3506ea5

	measure 'Average precision' = IF(HASONEVALUE('DimDetector'[detector_id]), SELECTEDVALUE('FactEvaluation'[average_precision]), BLANK())
		formatString: 0.000
		lineageTag: d34452f8-f97c-5b55-a5a6-97c4c62f4167

	measure 'Fit median ms' = IF(HASONEVALUE('DimDetector'[detector_id]), SELECTEDVALUE('FactEvaluation'[fit_median_ms]), BLANK())
		formatString: 0.00
		lineageTag: 09d5db12-3b34-5a10-a35b-759fec339e7c

	measure 'Model bytes' = IF(HASONEVALUE('DimDetector'[detector_id]), SELECTEDVALUE('FactEvaluation'[serialized_bytes]), BLANK())
		formatString: #,0
		lineageTag: b7fb29cd-2530-5e00-a60a-9de9728aecfe


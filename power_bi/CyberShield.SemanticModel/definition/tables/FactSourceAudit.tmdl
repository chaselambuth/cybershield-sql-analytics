table FactSourceAudit
	lineageTag: 4a2d666b-d816-5ebe-b632-6df4c2beea8b

	measure 'Audit value' = IF(HASONEVALUE('FactSourceAudit'[metric]) && HASONEVALUE('FactSourceAudit'[time_scope]) && HASONEVALUE('FactSourceAudit'[label_policy]) && HASONEVALUE('DimDataset'[dataset_id]), SELECTEDVALUE('FactSourceAudit'[value]), BLANK())
		formatString: #,0
		lineageTag: f3f818c5-e3df-559e-baf9-421613d352f0

	measure 'Original accepted' = CALCULATE(MAX('FactSourceAudit'[value]), REMOVEFILTERS('DimDataset'), 'DimDataset'[dataset_id] = "original", 'FactSourceAudit'[metric] = "accepted_rows")
		formatString: #,0
		lineageTag: 7ca032d0-ef9e-5fdf-b9fa-daf4c989e4b1

	measure 'Original quarantined' = CALCULATE(MAX('FactSourceAudit'[value]), REMOVEFILTERS('DimDataset'), 'DimDataset'[dataset_id] = "original", 'FactSourceAudit'[metric] = "rejected_rows")
		formatString: #,0
		lineageTag: f90d5bba-9e38-5f28-a8ca-ba7c1ad7c6de

	measure 'Original eligible' = CALCULATE(MAX('FactSourceAudit'[value]), REMOVEFILTERS('DimDataset'), 'DimDataset'[dataset_id] = "original", 'FactSourceAudit'[metric] = "temporal_eligible_rows")
		formatString: #,0
		lineageTag: 2c519cbd-842c-5943-8ebd-9325d22ee64e


table Window
	lineageTag: 20401460-19e2-5b97-afcb-6d5c02c5b2ce

	measure 'Observed flows' = SUM('Window'[flow_count])
		formatString: #,0
		lineageTag: aed9e784-be6b-5668-a757-6a082f250555

	measure 'Observed windows' = COUNTROWS('Window')
		formatString: #,0
		lineageTag: 8ae04d69-8402-5372-95c2-0ac18caee7ef

	measure 'Active sources' = DISTINCTCOUNT('Window'[src_ip])
		formatString: #,0
		lineageTag: e4da0537-a56b-50c3-ba12-46fe67910175

	measure Alerts = IF(HASONEVALUE('DimDetector'[detector_id]), CALCULATE(COUNTROWS('FactPrototypeDecision'), 'FactPrototypeDecision'[predicted_attack] = TRUE()), BLANK())
		formatString: #,0
		lineageTag: fd046722-990b-5d0d-80d1-04260a527093

	measure 'False alerts' = CALCULATE([Alerts], 'Window'[is_attack] = FALSE(), 'Window'[unknown_flows] = 0)
		formatString: #,0
		lineageTag: 7765d0a8-896f-50bc-a07d-b32a8181e40e

	measure 'Role context' = SELECTEDVALUE('Window'[role_context], "Multiple roles; retrospective decisions")
		lineageTag: f3df9546-3ef9-5b19-a624-b1e8d4a47fbe

	column window_key
		dataType: string
		isHidden
		lineageTag: 18d5b31c-c306-5836-a471-d24a8cc7f2ec
		summarizeBy: none
		sourceColumn: window_key

	column src_ip
		dataType: string
		lineageTag: 3c29f74e-84ed-5f4a-9e46-4b1fdd47fb65
		summarizeBy: none
